# Keep the server build context small: the repo carries ~8 GB of RL
# checkpoints/data and ~600 MB of git history that the image never needs.
.git
.idea
docs
web
webgame
target
project/target
project/project
server/target
src/test

# All RL artifacts except the models baked into the server image: the
# champion policy net and the v4 danger-head coach model (issue #37).
# (re-include the checkpoints dir entries so the walker descends, then
# exclude their contents again, keeping only the models)
rl/**
!rl/checkpoints
rl/checkpoints/**
!rl/checkpoints/best_raw_net.onnx
!rl/checkpoints/exit_v4
rl/checkpoints/exit_v4/**
!rl/checkpoints/exit_v4/exit_final.onnx

# stray pip-redirect artifacts at repo root
=*
